# Host ports for Docker Compose. Internal container ports remain 3000 and 4000.
FRONTEND_PORT=3000
BACKEND_PORT=4000

# Reserved for the database phase; not required or used by phase 0 health checks.
# Use your Neon PostgreSQL connection string here when database support is added.
# Never put this value in a NEXT_PUBLIC_* variable or commit a real credential.
DATABASE_URL=
