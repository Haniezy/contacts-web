# Host ports for Docker Compose. Internal container ports remain 3000 and 4000.
FRONTEND_PORT=3000
BACKEND_PORT=4000

# Neon pooled URL for the backend (hostname contains -pooler).
# Example: postgresql://USER:PASSWORD@HOST-pooler/contacts?sslmode=verify-full
# Never put either URL in NEXT_PUBLIC_* or commit real credentials.
DATABASE_URL=

# Neon direct URL for migrations (hostname does not contain -pooler).
# Example: postgresql://USER:PASSWORD@HOST/contacts?sslmode=verify-full
DIRECT_URL=

# Optional explicit opt-in for integration tests; use a development/test database.
# Tests roll back all temporary test records.
DATABASE_TEST_URL=
