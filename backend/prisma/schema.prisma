generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String    @id @default(uuid()) @db.Uuid
  email                    String    @unique @db.VarChar(254)
  passwordHash             String    @db.Text
  // Encrypted TOTP secret; encryption and key management belong to the auth phase.
  twoFactorSecretEncrypted String?   @db.Text
  twoFactorEnabled         Boolean   @default(false)
  // Store hashes only. Never persist plaintext recovery codes.
  recoveryCodeHashes       String[]  @default([])
  createdAt                DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(3)
  contacts                 Contact[]
}

model Contact {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String    @db.VarChar(200)
  phone     String    @db.VarChar(32)
  photoUrl  String?   @db.Text
  birthday  DateTime? @db.Date
  reminder  String?   @db.Text
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  // Both indexes also support userId-only lookups via their leading column.
  @@index([userId, name])
  @@index([userId, phone])
}
