{
  "name": "@contacts/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc -p tsconfig.check.json",
    "test": "prisma generate && tsx --test test/*.test.ts",
    "test:db": "prisma generate && tsx --test test/database.integration.ts",
    "test:auth": "prisma generate && tsx --test test/auth.integration.ts",
    "test:2fa": "prisma generate && tsx --test test/two-factor.integration.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "test:contacts": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.mjs --runInBand"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "cloudinary": "2.11.0",
    "cookie": "2.0.1",
    "cors": "2.8.6",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "jose": "6.2.12",
    "multer": "2.4.0",
    "otplib": "13.5.0",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.4"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "24.19.0",
    "@types/qrcode": "1.5.6",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
